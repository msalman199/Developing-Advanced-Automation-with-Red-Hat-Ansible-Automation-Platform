Subtask 1.3: Define Role Variables

    Edit the default variables file:

vim webserver/defaults/main.yml

    Add the following content:

---
# defaults file for webserver
webserver_package: httpd
webserver_service: httpd
webserver_port: 80
webserver_document_root: /var/www/html
webserver_index_file: index.html
webserver_user: apache
webserver_group: apache

# Configuration options
webserver_enable_ssl: false
webserver_ssl_port: 443
webserver_max_connections: 100

# Custom content
webserver_custom_content: |
  <html>
  <head>
    <title>Welcome to Our Web Server</title>
  </head>
  <body>
    <h1>Hello from Ansible Role!</h1>
    <p>This page was deployed using an Ansible role.</p>
    <p>Server configured on port {{ webserver_port }}</p>
  </body>
  </html>

Subtask 1.4: Create Role Tasks

    Edit the main tasks file:

vim webserver/tasks/main.yml

    Add the following tasks:

---
# tasks file for webserver

- name: Install web server package
  package:
    name: "{{ webserver_package }}"
    state: present
  become: yes
  tags:
    - install
    - webserver

- name: Create document root directory
  file:
    path: "{{ webserver_document_root }}"
    state: directory
    owner: "{{ webserver_user }}"
    group: "{{ webserver_group }}"
    mode: '0755'
  become: yes
  tags:
    - configure
    - webserver

- name: Deploy custom index page
  copy:
    content: "{{ webserver_custom_content }}"
    dest: "{{ webserver_document_root }}/{{ webserver_index_file }}"
    owner: "{{ webserver_user }}"
    group: "{{ webserver_group }}"
    mode: '0644'
  become: yes
  notify: restart webserver
  tags:
    - configure
    - content

- name: Configure web server
  template:
    src: httpd.conf.j2
    dest: /etc/httpd/conf/httpd.conf
    owner: root
    group: root
    mode: '0644'
    backup: yes
  become: yes
  notify: restart webserver
  when: webserver_package == "httpd"
  tags:
    - configure
    - webserver

- name: Start and enable web server service
  service:
    name: "{{ webserver_service }}"
    state: started
    enabled: yes
  become: yes
  tags:
    - service
    - webserver

- name: Open firewall port
  firewalld:
    port: "{{ webserver_port }}/tcp"
    permanent: yes
    state: enabled
    immediate: yes
  become: yes
  ignore_errors: yes
  tags:
    - firewall
    - webserver

Subtask 1.5: Create Role Handlers

    Edit the handlers file:

vim webserver/handlers/main.yml

    Add the following handlers:

---
# handlers file for webserver

- name: restart webserver
  service:
    name: "{{ webserver_service }}"
    state: restarted
  become: yes

- name: reload webserver
  service:
    name: "{{ webserver_service }}"
    state: reloaded
  become: yes

- name: restart firewall
  service:
    name: firewalld
    state: restarted
  become: yes

Subtask 1.6: Create Configuration Template

    Create a template for the web server configuration:

vim webserver/templates/httpd.conf.j2

    Add a basic Apache configuration template:

# Basic Apache Configuration Template
ServerRoot "/etc/httpd"
Listen {{ webserver_port }}

Include conf.modules.d/*.conf

User {{ webserver_user }}
Group {{ webserver_group }}

ServerAdmin root@localhost
ServerName localhost:{{ webserver_port }}

<Directory />
    AllowOverride none
    Require all denied
</Directory>

DocumentRoot "{{ webserver_document_root }}"

<Directory "{{ webserver_document_root }}">
    Options Indexes FollowSymLinks
    AllowOverride None
    Require all granted
</Directory>

<IfModule dir_module>
    DirectoryIndex {{ webserver_index_file }}
</IfModule>

<Files ".ht*">
    Require all denied
</Files>

ErrorLog "logs/error_log"
LogLevel warn

<IfModule log_config_module>
    LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined
    LogFormat "%h %l %u %t \"%r\" %>s %b" common
    CustomLog "logs/access_log" combined
</IfModule>

<IfModule mime_module>
    TypesConfig /etc/mime.types
    AddType application/x-compress .Z
    AddType application/x-gzip .gz .tgz
    AddType text/html .shtml
    AddOutputFilter INCLUDES .shtml
</IfModule>

AddDefaultCharset UTF-8

<IfModule mime_magic_module>
    MIMEMagicFile conf/magic
</IfModule>

EnableSendfile on

# Maximum number of connections
MaxRequestWorkers {{ webserver_max_connections }}

# Include additional configurations
IncludeOptional conf.d/*.conf

