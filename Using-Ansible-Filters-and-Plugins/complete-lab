Task 3: Combine Filters and Plugins in a Real-World Scenario
Subtask 3.1: Building an Infrastructure Reporting Playbook

Step 1: Create a comprehensive playbook combining filters and plugins

cat > infrastructure-management.yml << 'EOF'
---
- name: Infrastructure Management with Filters and Plugins
  hosts: localhost
  gather_facts: yes
  vars:
    server_inventory_file: "server_inventory.json"
    alert_threshold_cpu: 80
    alert_threshold_memory: 85

  tasks:
    - name: Create server inventory data
      copy:
        content: |
          {
            "servers": [
              {
                "hostname": "web-prod-01",
                "ip": "10.0.1.10",
                "role": "webserver",
                "environment": "production",
                "cpu_usage": 75,
                "memory_usage": 82,
                "disk_usage_bytes": 85899345920,
                "last_backup": "2024-01-10",
                "status": "active"
              },
              {
                "hostname": "web-prod-02",
                "ip": "10.0.1.11",
                "role": "webserver",
                "environment": "production",
                "cpu_usage": 68,
                "memory_usage": 79,
                "disk_usage_bytes": 92274688000,
                "last_backup": "2024-01-12",
                "status": "active"
              },
              {
                "hostname": "db-prod-01",
                "ip": "10.0.2.10",
                "role": "database",
                "environment": "production",
                "cpu_usage": 45,
                "memory_usage": 91,
                "disk_usage_bytes": 549755813888,
                "last_backup": "2024-01-14",
                "status": "maintenance"
              }
            ]
          }
        dest: "{{ server_inventory_file }}"

    - name: Load server inventory
      set_fact:
        infrastructure: "{{ lookup('json_query', server_inventory_file) }}"

    - name: Generate infrastructure summary
      debug:
        msg:
          - "Total servers: {{ infrastructure.servers | length }}"
          - "Active servers: {{ infrastructure.servers | selectattr('status', 'equalto', 'active') | list | length }}"
          - "Production webservers: {{ infrastructure.servers | selectattr('environment', 'equalto', 'production') | selectattr('role', 'equalto', 'webserver') | list | length }}"

    - name: Check servers requiring CPU attention
      debug:
        msg: "HIGH CPU: {{ item.hostname }} - {{ item.cpu_usage }}%"
      loop: "{{ infrastructure.servers }}"
      when: item.cpu_usage > alert_threshold_cpu

    - name: Check memory usage alerts
      debug:
        msg: "HIGH MEMORY: {{ item.hostname }} - {{ item.memory_usage }}%"
      loop: "{{ infrastructure.servers }}"
      when: item.memory_usage > alert_threshold_memory

    - name: Format disk usage for all servers
      debug:
        msg: "{{ item.hostname }}: {{ item.disk_usage_bytes | format_bytes }}"
      loop: "{{ infrastructure.servers }}"

    - name: Calculate average resource usage
      debug:
        msg:
          - "Average CPU usage: {{ (infrastructure.servers | map(attribute='cpu_usage') | sum / infrastructure.servers | length) | round(1) }}%"
          - "Average memory usage: {{ (infrastructure.servers | map(attribute='memory_usage') | sum / infrastructure.servers | length) | round(1) }}%"

    - name: Create maintenance schedule
      debug:
        msg: "Maintenance needed for: {{ infrastructure.servers | selectattr('status', 'equalto', 'maintenance') | map(attribute='hostname') | join(', ') }}"
EOF

Step 2: Run the comprehensive infrastructure management playbook

ansible-playbook infrastructure-management.yml

Deliverable: Output shows Total servers: 3, Active servers: 2, a HIGH MEMORY: db-prod-01 - 91% alert, formatted disk usage lines (e.g. web-prod-01: 80.00 GB), and Maintenance needed for: db-prod-01.
Subtask 3.2: Debugging Filters with a Diagnostic Playbook

Step 1: Create a debug playbook for testing filters end to end

cat > debug-filters.yml << 'EOF'
---
- name: Debug Filters and Variables
  hosts: localhost
  gather_facts: no
  vars:
    test_var: "Hello World"
    test_list: [1, 2, 3, 4, 5]
    test_dict: {key1: value1, key2: value2}

  tasks:
    - name: Debug variable types and values
      debug:
        msg:
          - "String: {{ test_var | upper }}"
          - "String type: {{ test_var | type_debug }}"
          - "List: {{ test_list }}"
          - "List type: {{ test_list | type_debug }}"
          - "List sum: {{ test_list | sum }}"
          - "Dict: {{ test_dict }}"
          - "Dict type: {{ test_dict | type_debug }}"
          - "Dict keys: {{ test_dict.keys() | list }}"

    - name: Debug with default filter for undefined variables
      debug:
        msg: "Undefined with default: {{ undefined_var | default('fallback_value') }}"

    - name: Debug combining custom and built-in filters
      debug:
        msg: "Custom + built-in: {{ test_var | reverse_string | lower }}"
EOF

Step 2: Run the debug playbook

ansible-playbook debug-filters.yml

Deliverable: Output shows String: HELLO WORLD, String type: str, List sum: 15, Dict type: dict, Undefined with default: fallback_value, and Custom + built-in: dlrow olleh. A clean run confirms both the type_debug built-in filter and the reverse_string custom filter from Task 1 are working together correctly.
