Subtask 1.2: Working with String, List, and Dictionary Filters

Step 1: Create a playbook to demonstrate string filters

cat > string-filters.yml << 'EOF'
---
- name: Demonstrate String Filters
  hosts: webservers
  gather_facts: no
  vars:
    sample_text: "  Hello World from Ansible  "
    server_name: "web-server-01"
    email_address: "admin@example.com"
    version_string: "2.4.1"

  tasks:
    - name: Display original string
      debug:
        msg: "Original: '{{ sample_text }}'"

    - name: Apply trim filter
      debug:
        msg: "Trimmed: '{{ sample_text | trim }}'"

    - name: Apply upper and lower case filters
      debug:
        msg:
          - "Uppercase: {{ sample_text | trim | upper }}"
          - "Lowercase: {{ sample_text | trim | lower }}"

    - name: Apply replace filter
      debug:
        msg: "Replaced: {{ server_name | replace('-', '_') }}"

    - name: Extract domain from email
      debug:
        msg: "Domain: {{ email_address | regex_replace('^.*@(.*)$', '\\1') }}"

    - name: Split version string
      debug:
        msg: "Version parts: {{ version_string.split('.') }}"

    - name: Get string length
      debug:
        msg: "Server name length: {{ server_name | length }}"
EOF

Step 2: Run the string filters playbook

ansible-playbook string-filters.yml

Step 3: Create a playbook for list and dictionary manipulation

cat > list-dict-filters.yml << 'EOF'
---
- name: Demonstrate List and Dictionary Filters
  hosts: webservers
  gather_facts: no
  vars:
    server_list:
      - "web01"
      - "web02"
      - "db01"
      - "web03"

    server_ports: [80, 443, 8080, 3306, 5432]

    server_config:
      web01:
        role: webserver
        port: 80
        status: active
      web02:
        role: webserver
        port: 443
        status: inactive
      db01:
        role: database
        port: 3306
        status: active

    mixed_numbers: [1, 5, 3, 9, 2, 7]

  tasks:
    - name: Filter web servers from list
      debug:
        msg: "Web servers: {{ server_list | select('match', '^web.*') | list }}"

    - name: Get unique values and sort
      debug:
        msg: "Sorted unique ports: {{ server_ports | unique | sort }}"

    - name: Get min, max, and sum values
      debug:
        msg:
          - "Min port: {{ server_ports | min }}"
          - "Max port: {{ server_ports | max }}"
          - "Sum of numbers: {{ mixed_numbers | sum }}"

    - name: Work with dictionary keys and values
      debug:
        msg:
          - "Server names: {{ server_config.keys() | list }}"
          - "Active servers: {{ server_config | dict2items | selectattr('value.status', 'equalto', 'active') | map(attribute='key') | list }}"

    - name: Group servers by role
      debug:
        msg: "Webservers: {{ server_config | dict2items | selectattr('value.role', 'equalto', 'webserver') | map(attribute='key') | list }}"

    - name: Join list elements
      debug:
        msg: "Servers as string: {{ server_list | join(', ') }}"
EOF

Step 4: Run the list and dictionary filters playbook

ansible-playbook list-dict-filters.yml

