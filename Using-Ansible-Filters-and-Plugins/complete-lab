Step 4: Create a playbook to test the custom lookup plugin

cat > custom-lookup.yml << 'EOF'
---
- name: Test Custom JSON Lookup Plugin
  hosts: localhost
  gather_facts: no

  tasks:
    - name: Load server data from JSON file
      set_fact:
        server_data: "{{ lookup('json_query', 'sample_data.json') }}"

    - name: Display all servers
      debug:
