Task 5: Dynamic Smart Inventory Updates
Subtask 5.1: Create a Host Modification Playbook

Create a playbook that changes host characteristics to test smart inventory dynamics:

---
- name: Modify Host Characteristics
  hosts: all
  become: yes
  tasks:
    - name: Install additional packages based on hostname
      package:
        name: "{{ item }}"
        state: present
      loop:
        - htop
        - vim
        - curl
      when: "'web' in inventory_hostname"
      
    - name: Set new custom facts
      copy:
        content: |
          server_role: {{ 'web' if 'web' in inventory_hostname else 'database' if 'db' in inventory_hostname else 'application' }}
          environment_type: {{ 'production' if 'prod' in inventory_hostname else 'staging' if 'stage' in inventory_hostname else 'development' }}
          last_updated: "{{ ansible_date_time.iso8601 }}"
          packages_installed: "{{ ansible_pkg_mgr }}"
        dest: /etc/ansible/facts.d/custom.fact
        mode: '0644'
      
    - name: Reload ansible facts
