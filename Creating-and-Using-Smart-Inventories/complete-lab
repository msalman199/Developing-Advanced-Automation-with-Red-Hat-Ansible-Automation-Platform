    Web Servers Smart Inventory:
        Name: Web Servers
        Host Filter: server_role:web or name:web

Subtask 3.2: Create Resource-Based Smart Inventories

Create smart inventories based on system resources:

    High Memory Servers:
        Name: High Memory Servers
        Host Filter: ansible_memtotal_mb:>=4096

    CentOS Servers:
        Name: CentOS Servers
        Host Filter: ansible_distribution:CentOS

    Ubuntu Servers:
        Name: Ubuntu Servers
        Host Filter: ansible_distribution:Ubuntu

Subtask 3.3: Complex Filter Examples

Create more sophisticated filters using logical operators:

# Multiple conditions with AND
ansible_os_family:RedHat and ansible_memtotal_mb:>=2048

# Multiple conditions with OR
ansible_distribution:Ubuntu or ansible_distribution:Debian

# Exclusion filters
ansible_os_family:Linux and not name:test

# Range filters
ansible_memtotal_mb:>=1024 and ansible_memtotal_mb:<=8192

# Pattern matching
name:web* or name:*prod*

Task 4: Using Smart Inventories for Configuration Management
Subtask 4.1: Create Role-Specific Configurations

Create playbooks that leverage smart inventories for targeted configuration:

    Web Server Configuration Playbook:

---
- name: Configure Web Servers
  hosts: all
  become: yes
  tasks:
    - name: Install web server packages
      package:
        name:
          - httpd
          - mod_ssl
        state: present
      when: ansible_os_family == "RedHat"
      
    - name: Install web server packages (Ubuntu/Debian)
      package:
        name:
          - apache2
          - apache2-utils
        state: present
      when: ansible_os_family == "Debian"
      
    - name: Start and enable web service
      service:
        name: "{{ 'httpd' if ansible_os_family == 'RedHat' else 'apache2' }}"
        state: started
        enabled: yes
        
    - name: Create web content
      copy:
        content: |
          <html>
          <head><title>{{ inventory_hostname }}</title></head>
          <body>
          <h1>Web Server: {{ inventory_hostname }}</h1>
          <p>OS: {{ ansible_distribution }} {{ ansible_distribution_version }}</p>
          <p>Role: {{ server_role | default('web') }}</p>
          <p>Environment: {{ environment_type | default('unknown') }}</p>
          </body>
          </html>
        dest: /var/www/html/index.html
        mode: '0644'

    Database Server Configuration Playbook:

---
- name: Configure Database Servers
  hosts: all
  become: yes
  tasks:
    - name: Install database packages
      package:
        name:
          - mariadb-server
          - mariadb
        state: present
      when: ansible_os_family == "RedHat"
      
    - name: Install database packages (Ubuntu/Debian)
      package:
        name:
          - mariadb-server
          - mariadb-client
        state: present
      when: ansible_os_family == "Debian"
      
    - name: Start and enable database service
      service:
        name: mariadb
        state: started
        enabled: yes
        
    - name: Create database configuration
      copy:
        content: |
          [mysqld]
          bind-address = 0.0.0.0
          max_connections = 100
          # Server: {{ inventory_hostname }}
          # Environment: {{ environment_type | default('unknown') }}
        dest: /etc/mysql/conf.d/custom.cnf
        mode: '0644'
      notify: restart mariadb
      
  handlers:
    - name: restart mariadb
      service:
        name: mariadb
        state: restarted

