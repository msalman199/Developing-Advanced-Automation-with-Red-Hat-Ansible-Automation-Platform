Task 2: Use the Inventory in a Playbook to Configure a Service
Subtask 2.1: Create a Comprehensive Service Configuration Playbook

Create a playbook that demonstrates using the static inventory to configure multiple services:

nano playbooks/configure-services.yml

---
- name: Configure Web Servers
  hosts: webservers
  become: yes
  gather_facts: yes
  
  tasks:
    - name: Display host information
      debug:
        msg: |
          Configuring {{ inventory_hostname }}
          Role: {{ server_role }}
          Environment: {{ environment }}
          Max Connections: {{ max_connections }}

    - name: Update package cache
      apt:
        update_cache: yes
        cache_valid_time: 3600
      when: ansible_os_family == "Debian"

    - name: Install web server packages
      apt:
        name: "{{ web_packages }}"
        state: present
      when: ansible_os_family == "Debian"

    - name: Create web directories
      file:
        path: "{{ item.document_root }}"
        state: directory
        owner: www-data
        group: www-data
        mode: '0755'
      loop: "{{ custom_vhosts | default([]) }}"
      when: custom_vhosts is defined

    - name: Configure nginx main configuration
      template:
        src: nginx.conf.j2
        dest: /etc/nginx/nginx.conf
        backup: yes
      notify: restart nginx

    - name: Configure virtual hosts
      template:
        src: vhost.conf.j2
        dest: "/etc/nginx/sites-available/{{ item.name }}"
      loop: "{{ custom_vhosts | default([]) }}"
      when: custom_vhosts is defined
      notify: restart nginx

    - name: Enable virtual hosts
      file:
        src: "/etc/nginx/sites-available/{{ item.name }}"
        dest: "/etc/nginx/sites-enabled/{{ item.name }}"
        state: link
      loop: "{{ custom_vhosts | default([]) }}"
      when: custom_vhosts is defined
      notify: restart nginx

    - name: Configure firewall rules
      ufw:
        rule: allow
        port: "{{ item.port }}"
        proto: "{{ item.protocol }}"
        src: "{{ item.source }}"
      loop: "{{ firewall_rules }}"
      when: firewall_rules is defined

    - name: Start and enable nginx service
      systemd:
        name: "{{ service_name }}"
        state: started
        enabled: yes

  handlers:
    - name: restart nginx
      systemd:
        name: nginx
        state: restarted

- name: Configure Database Servers
  hosts: databases
  become: yes
  gather_facts: yes
  
  tasks:
    - name: Display database server information
      debug:
        msg: |
          Configuring {{ inventory_hostname }}
          Database Role: {{ db_role }}
          Environment: {{ environment }}
          Max Connections: {{ max_connections }}

    - name: Install database packages
      apt:
        name: "{{ db_packages }}"
        state: present
      when: ansible_os_family == "Debian"

    - name: Create backup directory
      file:
        path: "{{ backup_config.backup_dir }}"
        state: directory
        owner: mysql
        group: mysql
        mode: '0750'

    - name: Configure MySQL
      template:
        src: my.cnf.j2
        dest: /etc/mysql/mysql.conf.d/custom.cnf
        backup: yes
      notify: restart mysql

    - name: Start and enable MySQL service
      systemd:
        name: "{{ service_name }}"
        state: started
        enabled: yes

    - name: Configure database firewall rules
      ufw:
        rule: allow
        port: "{{ item.port }}"
        proto: "{{ item.protocol }}"
        src: "{{ item.source }}"
      loop: "{{ firewall_rules }}"
      when: firewall_rules is defined

  handlers:
    - name: restart mysql
      systemd:
        name: mysql
        state: restarted

- name: Configure Load Balancers
  hosts: loadbalancers
  become: yes
  gather_facts: yes
  
  tasks:
    - name: Display load balancer information
      debug:
        msg: |
          Configuring {{ inventory_hostname }}
          Algorithm: {{ lb_algorithm }}
          Environment: {{ environment }}

    - name: Install HAProxy
      apt:
        name: haproxy
        state: present
      when: ansible_os_family == "Debian"

    - name: Configure HAProxy
      template:
        src: haproxy.cfg.j2
        dest: /etc/haproxy/haproxy.cfg
        backup: yes
      notify: restart haproxy

    - name: Start and enable HAProxy service
      systemd:
        name: "{{ service_name }}"
        state: started
        enabled: yes

  handlers:
    - name: restart haproxy
      systemd:
        name: haproxy
        state: restarted

Subtask 2.2: Create Template Files

Create the necessary template files for service configuration:

# Create templates directory
mkdir -p templates

# Create nginx configuration template
nano templates/nginx.conf.j2

user www-data;
worker_processes {{ nginx_worker_processes | default('auto') }};
pid /run/nginx.pid;

events {
    worker_connections {{ nginx_worker_connections | default('768') }};
    use epoll;
    multi_accept on;
}

http {
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    server_tokens off;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging Settings
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;
    error_log /var/log/nginx/error.log;

    # Gzip Settings
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Virtual Host Configs
    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}

# Create virtual host template
nano templates/vhost.conf.j2

server {
    listen {{ http_port }};
    {% if item.ssl_enabled %}
    listen {{ https_port }} ssl;
    {% endif %}
    
    server_name {{ item.name }};
    root {{ item.document_root }};
    index index.html index.htm index.php;

    {% if item.ssl_enabled %}
    ssl_certificate {{ ssl_certificate_path }}/{{ item.name }}.crt;
    ssl_certificate_key {{ ssl_private_key_path }}/{{ item.name }}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    {% endif %}

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php7.4-fpm.sock;
    }

    location ~ /\.ht {
        deny all;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
}

# Create MySQL configuration template
nano templates/my.cnf.j2

[mysqld]
bind-address = {{ mysql_config.bind_address }}
port = {{ db_port }}
max_connections = {{ mysql_config.max_connections }}

# InnoDB settings
innodb_buffer_pool_size = {{ mysql_config.innodb_buffer_pool_size }}
innodb_log_file_size = 256M
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT

# Query cache
query_cache_type = 1
query_cache_size = {{ mysql_config.query_cache_size }}

# Logging
log_error = /var/log/mysql/error.log
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2

# Binary logging for replication
{% if replication_enabled %}
log_bin = /var/log/mysql/mysql-bin.log
server_id = {{ ansible_default_ipv4.address.split('.')[-1] }}
{% endif %}

