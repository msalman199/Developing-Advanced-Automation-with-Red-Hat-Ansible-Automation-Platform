Subtask 5.3: Test Retry Functionality

Create a playbook that will demonstrate retry functionality:

# Create a playbook with intentional failures
cat > playbooks/retry-test.yml << 'EOF'
---
- name: Test Retry Functionality
  hosts: webservers[0]
  gather_facts: no
  tasks:
    - name: Task that will fail initially
      shell: |
        if [ ! -f /tmp/retry-success ]; then
          echo "Creating success marker for next retry"
          touch /tmp/retry-success
          exit 1
        else
          echo "Success on retry!"
          rm -f /tmp/retry-success
          exit 0
        fi
      register: retry_result
      retries: 3
      delay: 2
      until: retry_result.rc == 0

    - name: Display retry results
      debug:
        msg: "Task succeeded after retries: {{ retry_result.stdout }}"
EOF

# Run the retry test
ansible-playbook playbooks/retry-test.yml

