        url: "http://{{ hostvars['lb01']['ansible_host'] }}/disable/{{ inventory_hostname }}"
        method: POST
      delegate_to: lb01
      ignore_errors: yes
      
    - name: Perform rollback
      copy:
        src: "{{ backup_files.files | sort(attribute='mtime') | last | default('/var/www/html/index.html.backup') }}"
        dest: /var/www/html/index.html
        remote_src: yes
      when: backup_files.files | length > 0
      
    - name: Restart nginx
      service:
        name: nginx
        state: restarted
        
    - name: Verify rollback
      uri:
        url: "http://{{ inventory_hostname }}"
        method: GET
        status_code: 200
      register: rollback_check
      retries: 3
      delay: 5
      
    - name: Add back to load balancer
      uri:
        url: "http://{{ hostvars['lb01']['ansible_host'] }}/enable/{{ inventory_hostname }}"
        method: POST
      delegate_to: lb01
      ignore_errors: yes
      
