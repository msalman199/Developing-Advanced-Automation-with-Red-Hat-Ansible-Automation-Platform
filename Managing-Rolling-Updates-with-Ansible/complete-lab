Subtask 1.4: Create the Rolling Update Playbook

Now let's create a sophisticated rolling update playbook with proper error handling and validation.

cat > playbooks/rolling-update.yml << 'EOF'
---
- name: Rolling Update with Health Checks
  hosts: webservers
  become: yes
  serial: 1  # Update one server at a time
  max_fail_percentage: 25  # Allow up to 25% failures
  
  vars:
    app_version: "{{ new_version | default('2.0.0') }}"
    version_color: "{{ new_color | default('green') }}"
    health_check_url: "http://{{ inventory_hostname }}"
    health_check_retries: 5
    health_check_delay: 10
    
  pre_tasks:
    - name: Display update information
      debug:
        msg: "Starting rolling update for {{ inventory_hostname }} to version {{ app_version }}"
        
    - name: Verify server is reachable
      wait_for_connection:
        timeout: 30
        
  tasks:
    - name: Remove server from load balancer
      uri:
        url: "http://{{ hostvars['lb01']['ansible_host'] }}/disable/{{ inventory_hostname }}"
        method: POST
      delegate_to: lb01
      ignore_errors: yes
      
    - name: Wait for connections to drain
      wait_for:
        timeout: 30
      delegate_to: localhost
      
    - name: Create backup of current version
      copy:
        src: /var/www/html/index.html
        dest: /var/www/html/index.html.backup
        remote_src: yes
        
    - name: Deploy new version
      template:
        src: ../templates/index.html.j2
        dest: /var/www/html/index.html
        owner: nginx
        group: nginx
        mode: '0644'
        backup: yes
      notify: restart nginx
      
    - name: Flush handlers to restart nginx
      meta: flush_handlers
      
    - name: Wait for Nginx to be ready
      wait_for:
        port: 80
        host: "{{ inventory_hostname }}"
        delay: 5
        timeout: 60
        
    - name: Perform health check
      uri:
        url: "{{ health_check_url }}"
        method: GET
        status_code: 200
      register: health_check
      retries: "{{ health_check_retries }}"
      delay: "{{ health_check_delay }}"
      until: health_check.status == 200
      
    - name: Validate application version
      uri:
        url: "{{ health_check_url }}"
        method: GET
        return_content: yes
      register: version_check
      failed_when: app_version not in version_check.content
      
    - name: Add server back to load balancer
      uri:
        url: "http://{{ hostvars['lb01']['ansible_host'] }}/enable/{{ inventory_hostname }}"
        method: POST
      delegate_to: lb01
      ignore_errors: yes
      
  post_tasks:
    - name: Final health verification
      uri:
        url: "{{ health_check_url }}"
        method: GET
        status_code: 200
      register: final_check
      
    - name: Update completion notification
      debug:
        msg: "Successfully updated {{ inventory_hostname }} to version {{ app_version }}"
        
  handlers:
    - name: restart nginx
      service:
        name: nginx
        state: restarted
        
  rescue:
    - name: Rollback on failure
      copy:
        src: /var/www/html/index.html.backup
        dest: /var/www/html/index.html
        remote_src: yes
      when: health_check is failed
      
    - name: Restart nginx after rollback
      service:
        name: nginx
        state: restarted
      when: health_check is failed
      
    - name: Notify rollback
      debug:
        msg: "Rolled back {{ inventory_hostname }} due to health check failure"
      when: health_check is failed
EOF

Task 2: Implement Canary Deployment and Sequential Execution
Subtask 2.1: Understanding Canary Deployments

A canary deployment is a technique where you deploy a new version to a small subset of servers first, test it thoroughly, and then gradually roll it out to the rest of the infrastructure.
Subtask 2.2: Create Canary Deployment Playbook

cat > playbooks/canary-deployment.yml << 'EOF'
---
- name: Canary Deployment Strategy
  hosts: localhost
  gather_facts: no
  vars:
    app_version: "{{ new_version | default('3.0.0') }}"
    version_color: "{{ new_color | default('red') }}"
    canary_percentage: "{{ canary_percent | default(25) }}"
    
  tasks:
    - name: Calculate canary servers
      set_fact:
        total_servers: "{{ groups['webservers'] | length }}"
        canary_count: "{{ ((groups['webservers'] | length) * (canary_percentage | int) / 100) | round(0, 'ceil') | int }}"
        
    - name: Display canary deployment info
      debug:
        msg: 
          - "Total servers: {{ total_servers }}"
          - "Canary percentage: {{ canary_percentage }}%"
          - "Canary servers count: {{ canary_count }}"
          - "Deploying version: {{ app_version }}"

- name: Phase 1 - Canary Deployment
  hosts: webservers[0:{{ hostvars['localhost']['canary_count'] | int - 1 }}]
  become: yes
  serial: 1
  vars:
    app_version: "{{ hostvars['localhost']['app_version'] }}"
    version_color: "{{ hostvars['localhost']['version_color'] }}"
    
  tasks:
    - name: Deploy to canary servers
      include_tasks: ../tasks/deploy-with-checks.yml
      
    - name: Canary health monitoring
      uri:
        url: "http://{{ inventory_hostname }}"
        method: GET
        return_content: yes
      register: canary_health
      retries: 3
      delay: 10
      
    - name: Validate canary deployment
      assert:
        that:
          - canary_health.status == 200
          - app_version in canary_health.content
        fail_msg: "Canary deployment failed validation"
        success_msg: "Canary server {{ inventory_hostname }} validated successfully"

- name: Phase 2 - Canary Validation and Monitoring
  hosts: localhost
  gather_facts: no
  tasks:
    - name: Wait for canary monitoring period
      pause:
        prompt: "Canary deployment complete. Monitor for {{ canary_monitor_time | default(300) }} seconds. Press enter to continue with full deployment or Ctrl+C to abort"
        
    - name: Perform comprehensive canary tests
      uri:
        url: "http://{{ item }}"
        method: GET
        status_code: 200
      loop: "{{ groups['webservers'][0:canary_count | int] }}"
      register: canary_tests
      
    - name: Evaluate canary success
      set_fact:
        canary_success: "{{ canary_tests.results | selectattr('status', 'equalto', 200) | list | length == canary_count | int }}"
        
    - name: Abort if canary failed
      fail:
        msg: "Canary deployment failed. Aborting full rollout."
      when: not canary_success

- name: Phase 3 - Full Deployment
  hosts: webservers[{{ hostvars['localhost']['canary_count'] | int }}:]
  become: yes
  serial: "{{ batch_size | default(2) }}"
  vars:
    app_version: "{{ hostvars['localhost']['app_version'] }}"
    version_color: "{{ hostvars['localhost']['version_color'] }}"
    
  tasks:
    - name: Deploy to remaining servers
      include_tasks: ../tasks/deploy-with-checks.yml
      
    - name: Final validation
      uri:
        url: "http://{{ inventory_hostname }}"
        method: GET
        return_content: yes
      register: final_validation
      
    - name: Confirm deployment success
      debug:
        msg: "Successfully deployed version {{ app_version }} to {{ inventory_hostname }}"
EOF

