Advanced Features and Best Practices
Create a Comprehensive Deployment Script

cat > scripts/deploy.sh << 'EOF'
#!/bin/bash

# Advanced Deployment Script with Rolling Updates
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# Default values
DEPLOYMENT_TYPE="rolling"
APP_VERSION=""
BATCH_SIZE="1"
CANARY_PERCENT="25"
HEALTH_CHECK_TIMEOUT="60"
DRY_RUN="false"

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

usage() {
    echo "Usage: $0 [OPTIONS]"
    echo "Options:"
    echo "  -t, --type TYPE          Deployment type (rolling|canary|blue-green) [default: rolling]"
    echo "  -v, --version VERSION    Application version to deploy [required]"
    echo "  -b, --batch-size SIZE    Batch size for rolling updates [default: 1]"
    echo "  -c, --canary-percent %   Canary deployment percentage [default: 25]"
    echo "  -d, --dry-run           Perform dry run without actual deployment"
    echo "  -h, --help              Show this help message"
    echo ""
    echo "Examples:"
    echo "  $0 -t rolling -v 2.0.0 -b 2"
    echo "  $0 -t canary -v 3.0.0 -c 30"
    echo "  $0 -t blue-green -v 4.0.0"
}

log() {
    echo -e "${BLUE}[$(date +'%Y-%m-%d %H:%M:%S')]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -t|--type)
            DEPLOYMENT_TYPE="$2"
            shift 2
            ;;
        -v|--version)
            APP_VERSION="$2"
            shift 2
            ;;
        -b|--batch-size)
            BATCH_SIZE="$2"
            shift 2
            ;;
        -c|--canary-percent)
            CANARY_PERCENT="$2"
            shift 2
            ;;
        -d|--dry-run)
            DRY_RUN="true"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            error "Unknown option: $1"
            usage
            exit 1
            ;;
    esac
done

# Validate required parameters
if [[ -z "$APP_VERSION" ]]; then
    error "Application version is required"
    usage
    exit 1
fi

# Validate deployment type
case $DEPLOYMENT_TYPE in
    rolling|canary|blue-green)
        ;;
    *)
        error "Invalid deployment type: $DEPLOYMENT_TYPE"
        usage
        exit 1
        ;;
esac

log "Starting $DEPLOYMENT_TYPE deployment for version $APP_VERSION"

# Pre-deployment checks
log "Performing pre-deployment checks..."

# Check Ansible connectivity
if ! ansible all -i "$PROJECT_DIR/inventory/hosts.yml" -m ping > /dev/null 2>&1; then
    error "Ansible connectivity check failed"
    exit 1
fi

# Check current application status
log "Checking current application status..."
ansible webservers -i "$PROJECT_DIR/inventory/hosts.yml" -m uri -a "url=http://{{ inventory_hostname }} method=GET" --one-line

# Execute deployment based on type
case $DEPLOYMENT_TYPE in
    rolling)
        PLAYBOOK="$PROJECT_DIR/playbooks/rolling-update.yml"
        EXTRA_VARS="new_version=$APP_VERSION batch_size=$BATCH_SIZE"
        ;;
    canary)
        PLAYBOOK="$PROJECT_DIR/playbooks/canary-deployment.yml"
        EXTRA_VARS="new_version=$APP_VERSION canary_percent=$CANARY_PERCENT"
        ;;
    blue-green)
        PLAYBOOK="$PROJECT_DIR/playbooks/blue-green-rolling.yml"
        EXTRA_VARS="new_version=$APP_VERSION"
        ;;
esac

# Build ansible-playbook command
ANSIBLE_CMD="ansible-playbook -i $PROJECT_DIR/inventory/hosts.yml $PLAYBOOK -e \"$EXTRA_VARS\""

if [[ "$DRY_RUN" == "true" ]]; then
    ANSIBLE_CMD="$ANSIBLE_CMD --check --diff"
    warning "DRY RUN MODE - No actual changes will be made"
fi

log "Executing: $ANSIBLE_CMD"

# Execute deployment
if eval $ANSIBLE_CMD; then
    success "$DEPLOYMENT_TYPE deployment completed successfully!"
    
    # Post-deployment validation
    log "Performing post-deployment validation..."
    sleep 5
    
    # Check all servers
    for server in web01 web02 web03 web04; do
        if curl -s "http://$server" | grep -q "$APP_VERSION"; then
            success "$server: Version $APP_VERSION deployed successfully"
        else
            error "$server: Version validation failed"
        fi
    done
    
else
    error "$DEPLOYMENT_TYPE deployment failed!"
    exit 1
fi
EOF

chmod +x scripts/deploy.sh

