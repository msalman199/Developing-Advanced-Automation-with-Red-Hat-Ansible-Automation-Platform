### Subtask 1.4: Create a Database Role

1. **Create a database role**:

```bash
cd ../../
mkdir -p roles/database
cd roles/database
ansible-galaxy init . --force

    Define database role tasks:

vim tasks/main.yml

---
# tasks file for database
- name: Install MySQL/MariaDB server
  package:
    name: "{{ db_package_name }}"
    state: present
  become: yes

- name: Install Python MySQL client
  package:
    name: "{{ python_mysql_package }}"
    state: present
  become: yes

- name: Start and enable database service
  service:
    name: "{{ db_service_name }}"
    state: started
    enabled: yes
  become: yes

- name: Set root password
  mysql_user:
    name: root
    password: "{{ db_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
    state: present
  become: yes
  when: db_root_password is defined

- name: Create application database
  mysql_db:
    name: "{{ db_name }}"
    state: present
    login_user: root
    login_password: "{{ db_root_password | default(omit) }}"
  become: yes
  when: db_name is defined

- name: Create database user
  mysql_user:
    name: "{{ db_user }}"
    password: "{{ db_password }}"
    priv: "{{ db_name }}.*:ALL"
    state: present
    login_user: root
    login_password: "{{ db_root_password | default(omit) }}"
  become: yes
  when: db_user is defined and db_password is defined

    Define database role variables:

vim defaults/main.yml

---
# defaults file for database
db_package_name: "{{ 'mariadb-server' if ansible_os_family == 'RedHat' else 'mysql-server' }}"
db_service_name: "{{ 'mariadb' if ansible_os_family == 'RedHat' else 'mysql' }}"
python_mysql_package: "{{ 'python3-PyMySQL' if ansible_os_family == 'RedHat' else 'python3-pymysql' }}"
mysql_socket: "{{ '/var/lib/mysql/mysql.sock' if ansible_os_family == 'RedHat' else '/var/run/mysqld/mysqld.sock' }}"
db_root_password: "SecureRootPass123!"
db_name: "webapp_db"
db_user: "webapp_user"
db_password: "WebAppPass123!"

Subtask 1.5: Create Custom Playbooks

    Create a playbooks directory and main deployment playbook:

cd ../../
mkdir -p playbooks
vim playbooks/deploy_infrastructure.yml

---
- name: Deploy Web Infrastructure
  hosts: webservers
  become: yes
  vars:
    company_name: "{{ company_name | default('My Company Infrastructure') }}"
  
  tasks:
    - name: Update system packages
      package:
        name: '*'
        state: latest
      when: update_packages | default(false) | bool

    - name: Include webserver role
      include_role:
        name: mycompany.infrastructure.webserver

- name: Deploy Database Infrastructure
  hosts: databases
  become: yes
  
  tasks:
    - name: Include database role
      include_role:
        name: mycompany.infrastructure.database

- name: Verify deployment
  hosts: all
  tasks:
    - name: Check service status
      service_facts:
    
    - name: Display running services
      debug:
        msg: "{{ item }} is running"
      loop:
        - httpd
        - mariadb
      when: 
        - ansible_facts.services[item] is defined
        - ansible_facts.services[item].state == "running"

    Create a site configuration playbook:

vim playbooks/site.yml

---
- import_playbook: deploy_infrastructure.yml

- name: Configure monitoring
  hosts: all
  become: yes
  tasks:
    - name: Install monitoring tools
      package:
        name:
          - htop
          - iotop
          - nethogs
        state: present

    - name: Create monitoring script
      copy:
        content: |
          #!/bin/bash
          echo "=== System Status Report ==="
          echo "Date: $(date)"
          echo "Uptime: $(uptime)"
          echo "Disk Usage:"
          df -h
          echo "Memory Usage:"
          free -h
          echo "=== End Report ==="
        dest: /usr/local/bin/system-status.sh
        mode: '0755'

