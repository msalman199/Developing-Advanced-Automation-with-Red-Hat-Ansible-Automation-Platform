Task 4: Advanced Idempotency Patterns
Subtask 4.1: Conditional Idempotency

Create a more complex idempotent playbook with conditional logic:

cat > advanced-idempotent.yml << 'EOF'
---
- name: Advanced Idempotency Patterns
  hosts: all
  become: yes
  vars:
    app_config_dir: /etc/myapp
    app_config_file: "{{ app_config_dir }}/config.conf"
    required_packages:
      - httpd
      - mod_ssl
    
  tasks:
    - name: Ensure application directory exists
      file:
        path: "{{ app_config_dir }}"
        state: directory
        mode: '0755'
        owner: root
        group: root
      register: dir_result
      
    - name: Create application configuration file
      template:
        src: app_config.j2
        dest: "{{ app_config_file }}"
        mode: '0644'
        owner: root
        group: root
        backup: yes
      register: config_result
      notify: restart_service
      
    - name: Ensure required packages are installed
      yum:
        name: "{{ required_packages }}"
        state: present
      register: packages_result
      
    - name: Ensure Apache service is enabled and started
      systemd:
        name: httpd
        state: started
        enabled: yes
      register: service_result
      
    - name: Configure firewall for HTTP traffic
      firewalld:
        service: http
        permanent: yes
        state: enabled
        immediate: yes
      register: firewall_result
      ignore_errors: yes
      
    - name: Display summary of changes
      debug:
        msg:
          - "Directory: {{ 'created' if dir_result.changed else 'already exists' }}"
          - "Config: {{ 'updated' if config_result.changed else 'unchanged' }}"
          - "Packages: {{ 'installed' if packages_result.changed else 'already present' }}"
          - "Service: {{ 'configured' if service_result.changed else 'already running' }}"
          - "Firewall: {{ 'configured' if firewall_result.changed else 'already configured' }}"
          
  handlers:
    - name: restart_service
      systemd:
        name: httpd
        state: restarted
      listen: restart_service
EOF

